## @file
#  Пакет SoC MSM8937 / MSM8940 (Snapdragon 430 / 435).
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = Msm8937Pkg
  PACKAGE_GUID                   = 3b7d1c62-9e04-4f2a-8d51-6c2a7be93f18
  PACKAGE_VERSION                = 1.0

[Includes]
  Include

[Guids]
  gMsm8937PkgTokenSpaceGuid      = { 0x3b7d1c62, 0x9e04, 0x4f2a, { 0x8d, 0x51, 0x6c, 0x2a, 0x7b, 0xe9, 0x3f, 0x18 } }

[PcdsFixedAtBuild.common]
  # Шаг строки сплэш-буфера LK в байтах. Измерено на устройстве: 2160 (= 720*3,
  # без выравнивания; варианты 2176/2304/2880/2944 дали диагонали).
  gMsm8937PkgTokenSpaceGuid.PcdFbStride|2160|UINT32|0x00000001
  # Порядок байтов пикселя: 0 = R,G,B ; 1 = B,G,R.
  # TODO: подтвердить цветным тестом (для чёрно-белой консоли не важно).
  gMsm8937PkgTokenSpaceGuid.PcdFbRgbOrder|0|UINT32|0x00000002
  # Сдвиг начала сканирования MDSS относительно PcdMipiFrameBufferAddress, в байтах.
  # Измерено на устройстве: 256 (= 85.33 px). Обязательно кратен 4: иначе
  # 32-битные записи в Device-память дают alignment fault.
  gMsm8937PkgTokenSpaceGuid.PcdFbXShiftBytes|256|UINT32|0x00000003
  # 1 = рисовать отладочные полосы стадий (см. fw/patches/paint_stages.py)
  gMsm8937PkgTokenSpaceGuid.PcdDebugStageBands|1|UINT32|0x00000004
