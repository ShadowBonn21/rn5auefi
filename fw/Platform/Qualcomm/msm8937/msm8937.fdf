#
#  FDF для MSM8937/8940 (ugg).
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[FD.MSM8937_UEFI]
BaseAddress   = $(FD_BASE)|gArmTokenSpaceGuid.PcdFdBaseAddress
Size          = $(FD_SIZE)|gArmTokenSpaceGuid.PcdFdSize
ErasePolarity = 1

BlockSize     = 0x00001000        # 4 KiB
# NumBlocks * BlockSize обязан равняться FD_SIZE (0x00800000 / 0x1000 = 0x800)
NumBlocks     = 0x800

0x00000000|$(FD_SIZE)
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVMAIN_COMPACT

[FV.FvMain]
BlockSize          = 0x40
NumBlocks          = 0
FvAlignment        = 8
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

  INF MdeModulePkg/Core/Dxe/DxeMain.inf
  INF MdeModulePkg/Universal/PCD/Dxe/Pcd.inf
  INF ArmPkg/Drivers/CpuDxe/CpuDxe.inf
  INF MdeModulePkg/Core/RuntimeDxe/RuntimeDxe.inf
  INF MdeModulePkg/Universal/SecurityStubDxe/SecurityStubDxe.inf

  INF MdeModulePkg/Universal/CapsuleRuntimeDxe/CapsuleRuntimeDxe.inf
  INF EmbeddedPkg/EmbeddedMonotonicCounter/EmbeddedMonotonicCounter.inf
  INF MdeModulePkg/Universal/ResetSystemRuntimeDxe/ResetSystemRuntimeDxe.inf
  INF EmbeddedPkg/RealTimeClockRuntimeDxe/RealTimeClockRuntimeDxe.inf
  INF MdeModulePkg/Universal/ReportStatusCodeRouter/RuntimeDxe/ReportStatusCodeRouterRuntimeDxe.inf
  INF MdeModulePkg/Universal/StatusCodeHandler/RuntimeDxe/StatusCodeHandlerRuntimeDxe.inf
  INF EmbeddedPkg/MetronomeDxe/MetronomeDxe.inf

  # Консоль: framebuffer (наследуется от LK) + опционально UART
# INF EmbeddedPkg/SimpleTextInOutSerial/SimpleTextInOutSerial.inf   # нет UART: консоль только графическая (PcdDebugStageBands=0)
INF MdeModulePkg/Universal/Console/ConPlatformDxe/ConPlatformDxe.inf
INF MdeModulePkg/Universal/Console/ConSplitterDxe/ConSplitterDxe.inf
# INF MdeModulePkg/Universal/Console/GraphicsConsoleDxe/GraphicsConsoleDxe.inf   # ВРЕМЕННО: проверка, не он ли висит на нашем GOP
# INF MdeModulePkg/Universal/Console/TerminalDxe/TerminalDxe.inf   # нет UART: консоль только графическая (PcdDebugStageBands=0)

  INF ArmPkg/Drivers/ArmGic/ArmGicDxe.inf
  INF ArmPkg/Drivers/TimerDxe/TimerDxe.inf
  INF MdeModulePkg/Universal/WatchdogTimerDxe/WatchdogTimer.inf

  # ── BSP-драйверы msm8937 ───────────────────────────────────────────────
!include Platform/Qualcomm/msm8937/dxe.fdf.inc

  # Framebuffer: свой драйвер под 24bpp (RGB888) и stride 2160.
  # Панель включает LK, UEFI только рисует в его буфер 0x90000000.
  INF Silicon/Qualcomm/msm8937/Drivers/UggFbDxe/UggFbDxe.inf

  # ── Диски: нужен драйвер SDCC (eMMC) — СЕЙЧАС ОТСУТСТВУЕТ ──────────────
  # Без него UEFI не увидит ни одного раздела. См. docs/02-bringup-plan.md, G3.
INF MdeModulePkg/Universal/Disk/DiskIoDxe/DiskIoDxe.inf
INF MdeModulePkg/Universal/Disk/PartitionDxe/PartitionDxe.inf
INF FatPkg/EnhancedFatDxe/Fat.inf
INF MdeModulePkg/Universal/Disk/UnicodeCollation/EnglishDxe/EnglishDxe.inf

  # ── USB host ───────────────────────────────────────────────────────────
# INF MdeModulePkg/Bus/Usb/UsbBusDxe/UsbBusDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера
# INF MdeModulePkg/Bus/Usb/UsbMassStorageDxe/UsbMassStorageDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера
# INF MdeModulePkg/Bus/Usb/UsbKbDxe/UsbKbDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера

  # ── FDT / SMBIOS / BDS ─────────────────────────────────────────────────
# INF EmbeddedPkg/Drivers/DtPlatformDxe/DtPlatformDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера
# INF Platform/RenegadePkg/Drivers/PlatformSmbiosDxe/PlatformSmbiosDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера
# INF MdeModulePkg/Universal/SmbiosDxe/SmbiosDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера
# INF MdeModulePkg/Universal/HiiDatabaseDxe/HiiDatabaseDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера
# INF MdeModulePkg/Universal/PrintDxe/PrintDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера
  INF MdeModulePkg/Universal/DevicePathDxe/DevicePathDxe.inf
# INF MdeModulePkg/Universal/DisplayEngineDxe/DisplayEngineDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера
# INF MdeModulePkg/Universal/SetupBrowserDxe/SetupBrowserDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера
# INF MdeModulePkg/Universal/DriverHealthManagerDxe/DriverHealthManagerDxe.inf   # ВРЕМЕННО: поиск зависшего драйвера
INF MdeModulePkg/Universal/BdsDxe/BdsDxe.inf
INF MdeModulePkg/Application/UiApp/UiApp.inf
INF Platform/RenegadePkg/Drivers/LogoDxe/LogoDxe.inf

  # UEFI Shell + SimpleInit (GUI-загрузчик, как на остальных устройствах Renegade)
INF ShellPkg/Application/Shell/Shell.inf
INF src/main/SimpleInitMain.inf

  INF MdeModulePkg/Universal/Variable/RuntimeDxe/VariableRuntimeDxe.inf

# Device specific fdf
!include $(DEVICE_DXE_FV_COMPONENTS)

[FV.FVMAIN_COMPACT]
FvAlignment        = 8
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

  INF Silicon/Qualcomm/QcomPkg/PrePi/PrePi.inf

  FILE FV_IMAGE = 9E21FD93-9C72-4c15-8C4B-E77F1DB2D792 {
    SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
      SECTION FV_IMAGE = FVMAIN
    }
  }

!include Silicon/Qualcomm/QcomPkg/QcomCommonFdf.inc
